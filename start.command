#!/bin/zsh

# Πλοήγηση στον φάκελο του project
DIR="/Users/spiros/Desktop/mikroi-mathites"
cd "$DIR" || exit 1

echo "=================================================="
echo "🎈 Μικροί Μαθητές - Εκκίνηση Εφαρμογής..."
echo "=================================================="
echo ""
echo "📱 Για iPad / Κινητό (στο ίδιο Wi-Fi), δες τη διεύθυνση Network παρακάτω."
echo "💻 Ανοίγει αυτόματα στο πρόγραμμα περιήγησης..."
echo ""
echo "Για να κλείσεις τον server: πάτησε Control + C στο παράθυρο αυτό."
echo "=================================================="
echo ""

# Άνοιγμα browser μετά από 1.5 δευτερόλεπτο
(sleep 1.5 && open "http://localhost:5173") &

# Εκκίνηση του Vite dev server με πρόσβαση σε όλο το τοπικό δίκτυο
npm run dev -- --host 0.0.0.0
